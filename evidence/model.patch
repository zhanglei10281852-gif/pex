+        # not a failure: re-running with the same cutoff simply re-converges against the disk.
+        if not os.path.lexists(path):
+            pruned_paths.append(
+                PrunedPath(path=path, status=SUCCEEDED, disk_usage=_zero_disk_usage(path))
+            )
