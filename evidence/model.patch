+def unzip_dir_for(pex_path):
+    # type: (str) -> UnzipDir
+    pex_info = PexInfo.from_pex(pex_path)
+    assert pex_info.pex_hash is not None
+    return UnzipDir.create(pex_info.pex_hash)
