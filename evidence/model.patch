+# Per-entry prune statuses. A dependency whose candidate consumers failed to be deleted is
+# `skipped`; a path whose deletion was attempted but which survives is `failed`; only paths
+# confirmed gone are `succeeded`.
+SUCCEEDED = "succeeded"
+FAILED = "failed"
+SKIPPED = "skipped"
