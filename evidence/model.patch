+    assert Pidfile.load(server.name, cache_dir).is_current()
+
+
+def test_dead_pid_record_is_reclaimed(server, doc_root):
+    # type: (Server, str) -> None
+    dead = subprocess.Popen(args=[sys.executable, "-c", "import sys; sys.exit(0)"])
+    dead.wait()
+
+    _write_pidfile(
+        server.cache_dir,
